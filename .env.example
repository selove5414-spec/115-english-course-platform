# Notion 整合 API 金鑰 (在 https://www.notion.so/profile/integrations 建立)
NOTION_API_KEY=secret_your_notion_api_key_here

# 1. 115(1) 行事曆資料庫 ID (Calendar Database)
# 欄位建議: Title (標題), Date (日期/範圍), Category (類別標籤: 段考/會議/活動), Completed (核取方塊), Responsible (負責人)
NOTION_DB_CALENDAR_ID=your_calendar_database_id_here

# 2. 段考出題分配資料庫 ID (Exam Setters Database)
# 欄位建議: Subject (年級科目), Exam1_Teacher (第一次段考出題), Exam2_Teacher (第二次段考出題), Final_Teacher (期末考出題)
NOTION_DB_EXAM_ID=your_exam_database_id_here

# 3. 授課名冊與節數資料庫 ID (Course & Teaching Hours Database)
# 欄位建議: Class (班級/組別), Grade (年級), MainTeacher (正課教師), MainHours (正課節數), TutorTeacher (輔導教師), TutorHours (輔導節數)
NOTION_DB_COURSE_ID=your_course_database_id_here

# 4. 書卷與雜誌訂購資料庫 ID (Magazine Orders Database)
# 欄位建議: Grade (年級), Publication (刊物名稱), Months (期數月份), Quantity (配送人數/份數), GiftNotes (贈書備註)
NOTION_DB_MAGAZINE_ID=your_magazine_database_id_here
